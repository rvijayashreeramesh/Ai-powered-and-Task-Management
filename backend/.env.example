# Server & Port (Render injects PORT automatically)
PORT=8000

# Database (MongoDB Atlas or Local MongoDB)
# Supported aliases: MONGODB_URL, DATABASE_URL, MONGODB_URI
MONGODB_URL=
MONGODB_DATABASE=project_db

# JWT Authentication
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Google Gemini AI (Exclusively required for AI copilot features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CORS Configuration (Allowed frontend URLs, comma-separated)
CORS_ORIGINS=https://ai-powered-and-task-management-8rw7-bdagteqtz-vijayashree1.vercel.app
